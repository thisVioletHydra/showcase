{
  "name": "backend",
  "private": true,
  "type": "module",
  "imports": {
    "#config": "./src/config.ts",
    "#db": "./src/db.ts",
    "#schema": "./src/schema.ts",
    "#seed": "./src/seed.ts",
    "#types": "./src/types.ts",
    "#http/*": "./src/http/*.ts",
    "#routes/*": "./src/routes/*.ts",
    "#services/*": "./src/services/*.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/dev-backend.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --import ./test/preload.ts --test test/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@showcase/oxlint-rules": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.3.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
