{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "#config": ["./src/config.ts"],
      "#db": ["./src/db.ts"],
      "#schema": ["./src/schema.ts"],
      "#seed": ["./src/seed.ts"],
      "#types": ["./src/types.ts"],
      "#http/*": ["./src/http/*"],
      "#routes/*": ["./src/routes/*"],
      "#services/*": ["./src/services/*"]
    }
  },
  "include": ["src/**/*"]
}
