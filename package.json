{
  "name": "showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "front": "pnpm --filter frontend dev",
    "back": "pnpm --filter backend dev",
    "build:backend": "pnpm --filter backend build",
    "start:backend": "pnpm --filter backend start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "race:webhook": "node scripts/race-webhook.mjs",
    "race:promo": "node scripts/race-promo.mjs",
    "race:early": "node scripts/race-early-webhook.mjs",
    "test": "pnpm --filter backend test"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@oxyhub/oxlint-plugin": "^0.3.0",
    "oxlint": "^1.80.0"
  }
}
