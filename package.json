{
  "name": "showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "front": "pnpm --filter frontend dev",
    "back": "pnpm --filter backend dev",
    "lint": "pnpm -r exec oxlint --deny-warnings",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "race:webhook": "node scripts/race-webhook.mjs",
    "race:promo": "node scripts/race-promo.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@showcase/oxlint-rules": "workspace:*",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001"
  }
}
