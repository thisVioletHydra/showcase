{
  "eslint.enable": false,
  "files.associations": {
    "*.svg": "xml"
  },
  "editor.semanticHighlighting.enabled": true,
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "component": {
        "foreground": "#4ADE80",
        "fontStyle": "underline"
      }
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "support.class.component",
          "support.class.component.tsx",
          "support.class.component.jsx"
        ],
        "settings": {
          "foreground": "#4ADE80",
          "fontStyle": "underline"
        }
      }
    ]
  },
  "editor.codeActionsOnSaveMode": "all",
  "oxc.enable": true,
  "oxc.enable.oxfmt": false,
  "oxc.enable.oxlint": true,
  "oxc.typeAware": true,
  "oxc.fixKind": "all",
  "oxc.lint.run": "onType",
  "oxc.disableNestedConfig": false,
  "oxc.requireConfig": false,
  "[javascript]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null,
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "always",
      "source.format.oxc": "never"
    }
  },
  "[javascriptreact]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null,
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "always",
      "source.format.oxc": "never"
    }
  },
  "[typescript]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null,
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "always",
      "source.format.oxc": "never"
    }
  },
  "[typescriptreact]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null,
    "editor.codeActionsOnSave": {
      "source.fixAll.oxc": "always",
      "source.format.oxc": "never"
    }
  }
}
